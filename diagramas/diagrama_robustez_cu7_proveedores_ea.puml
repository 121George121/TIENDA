@startuml Diagrama_Robustez_CU07_Gestionar_Proveedores_EA
' ==============================================================================
' DIAGRAMA DE ROBUSTEZ Y COMUNICACIÓN (BCE) - CU07
' Caso de Uso: CU07 - Gestionar Proveedores y Productos/Telas Suministrados
' Estilo: Enterprise Architect 15 / 16 (Notación de Ivar Jacobson / ICONIX)
' Proyecto: ECOMMERCE_TIENDA (SaaS Multi-Tenant)
' ==============================================================================

title **sd Diagrama de Comunicacion / Robustez - CU07 Gestionar Proveedores y Suministros**

left to right direction

' --- CONFIGURACIÓN DE ESTILO ENTERPRISE ARCHITECT ---
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam shadowing true
skinparam roundcorner 12

skinparam actor {
    BackgroundColor #FFF2CC
    BorderColor #2C3E50
    FontColor #1A252F
    FontStyle bold
}

skinparam boundary {
    BackgroundColor #D4EFF2
    BorderColor #1B4F72
    FontColor #17202A
    FontStyle bold
}

skinparam control {
    BackgroundColor #D4EFF2
    BorderColor #1B4F72
    FontColor #17202A
    FontStyle bold
}

skinparam entity {
    BackgroundColor #D4EFF2
    BorderColor #1B4F72
    FontColor #17202A
    FontStyle bold
}

skinparam arrow {
    Color #2C3E50
    FontColor #1B2631
    FontSize 10
}

' ==============================================================================
' 1. ACTOR
' ==============================================================================
actor "Administrador / Encargado\nde Compras e Insumos" as ActAdmin

' ==============================================================================
' 2. MÚLTIPLES VISTAS / BOUNDARIES
' ==============================================================================
boundary "Page : Directorio Proveedores" as B_ProvList
boundary "Page : Modal Registro Proveedor" as B_ProvModal
boundary "Page : Modal Suministros y Costos" as B_SumModal
boundary "Page : Modal Evaluacion Proveedor" as B_EvalModal

' ==============================================================================
' 3. MÚLTIPLES CONTROLADORES / CONTROLS
' ==============================================================================
control "Gestor : Proveedores\n(ProveedorController)" as C_Prov
control "Validador : NIT y Registro\n(Commercial Registry Validator)" as C_NitVal
control "Gestor : Catalogo Suministros\n(Supply Chain Cost Manager)" as C_Supply
control "Gestor : Bitacora\n(BitacoraController)" as C_Bitacora

' ==============================================================================
' 4. MÚLTIPLES ENTIDADES / ENTITIES
' ==============================================================================
entity "Proveedor" as E_Proveedor
entity "Producto Proveedor" as E_ProdProv
entity "Producto / Prenda" as E_Producto
entity "Empresa / Tenant" as E_Tenant
entity "Bitacora" as E_Bitacora

' ==============================================================================
' FLUJOS Y MENSAJES NUMERADOS (COMUNICACIÓN ROBUSTEZ BCE)
' ==============================================================================

' --- ACTOR A VISTAS ---
ActAdmin -- B_ProvList : 1: Consultar Proveedores(search, activo) >\n8: Mostrar Tabla Proveedores() <
ActAdmin -- B_ProvModal : 9: Registrar Nuevo Proveedor(form) >
ActAdmin -- B_SumModal : 18: Vincular Insumo / Prenda(costo) >
ActAdmin -- B_EvalModal : 28: Calificar Cumplimiento y Tiempos() >

' --- VISTAS A CONTROLADORES ---
B_ProvList -- C_Prov : 2: listar_proveedores(tenant_id, search) >\n7: ListaProveedoresResponse(items) <
B_ProvModal -- C_Prov : 10: crear_proveedor(payload) >\n16: ProveedorCreado(id, nit) <
B_ProvModal -- B_ProvList : 17: Actualizar Tabla() >
B_SumModal -- C_Supply : 19: vincular_suministro(prov_id, prod_id, costo) >\n26: SuministroVinculado() <
B_EvalModal -- C_Prov : 29: registrar_evaluacion(prov_id, rating) >\n32: EvaluacionGuardada() <

' --- CONTROLADOR DE PROVEEDORES CON ENTIDADES ---
C_Prov -- E_Tenant : 3: Validar Tenant Activo() >
C_Prov -- E_Proveedor : 4: Buscar Proveedores Filtrados() >\n5: Retornar Lista() <\n14: Guardar Nuevo ProveedorModel() >\n30: Actualizar Calificacion() >

' --- ORQUESTACIÓN CON VALIDADOR DE NIT ---
C_Prov -- C_NitVal : 11: validar_nit_tributario(nit) >\n13: NitAprobado(bool) <
C_NitVal -- E_Proveedor : 12: Comprobar NIT Unico() >

' --- ORQUESTACIÓN DE SUMINISTROS Y COSTOS ---
C_Supply -- E_Proveedor : 20: Validar Proveedor Activo() >
C_Supply -- E_Producto : 21: Validar Prenda o Tela Existente() >
C_Supply -- E_ProdProv : 22: Guardar Costo Compra y Cantidad Minima() >\n23: Registro Suministro Confirmado() <

' --- AUDITORÍA EN BITÁCORA ---
C_Prov -- C_Bitacora : 15: log_bitacora(CREAR_PROVEEDOR) >\n31: log_bitacora(EVALUAR_PROVEEDOR) >
C_Supply -- C_Bitacora : 24: log_bitacora(VINCULAR_SUMINISTRO) >
C_Bitacora -- E_Bitacora : 25: Guardar Log Auditoria() >

@enduml
